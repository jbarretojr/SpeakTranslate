# Copie este arquivo para ".env" (que é ignorado pelo git) e preencha com seus
# próprios valores. Nenhuma variável aqui é obrigatória — cada uma só afeta a
# aba/recurso que a usa, e os campos continuam editáveis na interface mesmo
# sem um .env (ver env_config.py).

# Botão "Sugerir resposta" (llm_suggest.py). Gere uma chave em
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Aba "Entrevista" (interview_gui.py / obs_controller.py) — evita ter que
# redigitar a senha do servidor WebSocket do OBS a cada vez que o app abre.
# Pegue a senha no OBS em Ferramentas > WebSocket Server Settings > Show
# Connect Info. Host/porta só precisam ser preenchidos se você mudou o padrão
# (localhost:4455) nas configurações do OBS.
OBS_WEBSOCKET_PASSWORD=
OBS_WEBSOCKET_HOST=
OBS_WEBSOCKET_PORT=
